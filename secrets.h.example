// secrets.h.example
// Copy this file to secrets.h and fill in your own values. secrets.h is
// gitignored so your real credentials never get committed.
#ifndef SECRETS_H
#define SECRETS_H

// WiFi (2.4GHz only -- ESP32 doesn't support 5GHz networks)
#define SECRET_WIFI_SSID "YOUR_WIFI_SSID"
#define SECRET_WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// Spotify (from https://developer.spotify.com/dashboard, plus the one-time
// OAuth authorization-code exchange for the refresh token)
#define SECRET_SPOTIFY_CLIENT_ID "YOUR_SPOTIFY_CLIENT_ID"
#define SECRET_SPOTIFY_CLIENT_SECRET "YOUR_SPOTIFY_CLIENT_SECRET"
#define SECRET_SPOTIFY_REFRESH_TOKEN "YOUR_SPOTIFY_REFRESH_TOKEN"

// Remote message/drawing relay (Netlify site in remote-message/), must match
// the MESSAGE_SECRET env var set on that site
#define SECRET_REMOTE_MESSAGE_URL "https://YOUR-SITE.netlify.app/api/message"
#define SECRET_REMOTE_DRAWING_URL "https://YOUR-SITE.netlify.app/api/drawing"
#define SECRET_REMOTE_BUNDLE_URL "https://YOUR-SITE.netlify.app/api/bundle"
#define SECRET_REMOTE_ROTATION_URL "https://YOUR-SITE.netlify.app/api/rotation"
#define SECRET_REMOTE_SLIDES_URL "https://YOUR-SITE.netlify.app/api/slides"
#define SECRET_REMOTE_KEY "YOUR_RANDOM_SHARED_SECRET"

#endif
